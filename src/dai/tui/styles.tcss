/* The dai screens. Sections are separated by single rules rather than boxes:
   one frame around everything wastes two columns and boxes the panes in twice.

   Every colour here — $background, $surface and friends, and the three $dai-*
   below — comes from the theme in theme.py, so the sheet follows the terminal
   between light and dark. Declaring any of them here would pin it: a `$var:`
   in the source wins over the theme's. A host that loads this sheet has to
   call theme.apply_theme() first. */

Screen {
    layout: vertical;
    background: $background;
}

/* --- the header ------------------------------------------------------- */

/* Three rows of content — the pill needs its own box — plus the rule. */
StatusBar {
    height: 4;
    dock: top;
    padding: 0 2;
    background: $background;
    border-bottom: solid $dai-rule;
}

StatusBar > #brand {
    width: auto;
    height: 1;
    margin: 1 2 0 0;
}

StatusBar > #progress {
    width: 1fr;
    height: 1;
    margin: 1 0 0 0;
}

/* The pill needs its own three rows, which is what sets the header height. */
StatusBar > #phase-pill {
    width: auto;
    height: 3;
    padding: 0 1;
    border: round $dai-rule;
}

/* --- the two panes ---------------------------------------------------- */

#panes {
    height: 1fr;
}

AgentPane {
    width: 1fr;
}

/* The divider. Drawn inside the solver's own box, so the panes still tile
   edge to edge and each keeps exactly half the width. */
AgentPane#solver {
    border-right: solid $dai-rule;
}

.pane-title {
    width: 100%;
    height: 3;
    padding: 1 2 0 2;
    color: $dai-muted;
    border-bottom: solid $dai-rule;
}

/* Whose turn it is. The title's colours are baked into its text, so the cue
   has to be the background. */
AgentPane.active .pane-title {
    background: $surface;
}

.pane-idle {
    height: 1fr;
    content-align: center middle;
    text-align: center;
}

.pane-log {
    height: 1fr;
    padding: 1 2;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-color: $dai-rule;
    scrollbar-color-hover: $dai-muted;
    scrollbar-color-active: $dai-solver;
}

.pane-activity {
    dock: bottom;
    height: 1;
    padding: 0 2;
}

/* --- the running score ------------------------------------------------- */

VerdictLog {
    height: 8;
    padding: 1 2;
    border-top: solid $dai-rule;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-color: $dai-rule;
    scrollbar-color-hover: $dai-muted;
    scrollbar-color-active: $dai-solver;
}

/* --- the key row ------------------------------------------------------- */

Footer {
    height: 2;
    padding: 0 2;
    background: $background;
    border-top: solid $dai-rule;
}

Footer FooterKey {
    padding: 0 1 0 0;
}

/* Textual zeroes the key padding in compact mode; the keycap needs it back. */
Footer FooterKey.-compact .footer-key--key,
Footer FooterKey .footer-key--key {
    padding: 0 1;
}

Footer FooterKey.-compact .footer-key--description,
Footer FooterKey .footer-key--description {
    padding: 0 0 0 1;
}

/* --- the task prompt --------------------------------------------------- */

Screen.task-prompt {
    align: center middle;
}

#prompt-card {
    width: 88%;
    max-width: 96;
    height: auto;
}

#prompt-card > CompletingInput {
    margin: 0 0 0 2;
}

/* The title's bullet, the input's bar and the hints all hang off the same two
   columns; the text of each sits three further in. */
#prompt-title {
    height: 1;
    margin: 0 0 1 2;
}

/* auto, not 1: on a narrow terminal the row wraps rather than losing keys. */
#prompt-hints {
    height: auto;
    margin: 1 0 0 5;
}

/* --- the @ picker ------------------------------------------------------ */

CompletingInput {
    height: auto;
}

/* The bar down the left edge marks where the text you are writing begins. */
CompletingInput > PromptArea {
    width: 100%;
    height: auto;
    max-height: 12;
    padding: 0 2;
    background: transparent;
    color: $foreground;
    border-left: tab $dai-solver;
}

CompletingInput > #completions-label {
    height: 1;
    margin: 1 0 0 3;
    color: $dai-muted;
}

/* The dropdown grows with its results but never swallows the screen. */
CompletingInput > OptionList {
    height: auto;
    max-height: 10;
    margin: 0 0 0 3;
    padding: 1 1;
    border: none;
    background: $surface;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-color: $dai-rule;
}

CompletingInput > OptionList > .option-list--option {
    padding: 0 2;
    color: $dai-muted;
}

/* --- the modals -------------------------------------------------------- */

InjectScreen {
    align: center middle;
}

InjectScreen > Vertical {
    width: 80%;
    max-width: 96;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $dai-rule;
}

InjectScreen Label {
    margin: 0 0 1 0;
    color: $dai-muted;
}

DeadlockScreen {
    align: center middle;
}

DeadlockScreen > Vertical {
    width: 80%;
    max-width: 96;
    max-height: 80%;
    padding: 1 2;
    background: $surface;
    border: round $warning;
}

DeadlockScreen .title {
    text-style: bold;
    color: $warning;
}

/* A Horizontal is 1fr tall by default, which stretches an auto-height card
   down the whole screen. The button rows are as tall as their buttons. */
DeadlockScreen > Vertical > Horizontal,
ConfirmQuitScreen > Vertical > Horizontal,
MergeScreen > Vertical > Horizontal {
    height: auto;
}

DeadlockScreen Button {
    margin: 0 1 0 0;
}

#deadlock-issues {
    height: auto;
    max-height: 12;
    margin: 1 0;
    scrollbar-size-vertical: 1;
}

ConfirmQuitScreen {
    align: center middle;
}

ConfirmQuitScreen > Vertical {
    width: 60;
    max-width: 80%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $error;
}

ConfirmQuitScreen .title {
    text-style: bold;
    color: $error;
}

ConfirmQuitScreen Button {
    margin: 1 1 0 0;
}

/* --- the merge screen -------------------------------------------------- */

MergeScreen {
    align: center middle;
}

MergeScreen > Vertical {
    width: 80%;
    max-width: 96;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $dai-rule;
}

/* Auto rather than a fixed row: in a narrow terminal these sentences wrap, and
   a card that grows is better than a sentence that stops mid-word. The card
   has its own max-height, and the rows below scroll, so nothing runs away. */
#merge-outcome,
#merge-title {
    height: auto;
}

#merge-title,
#merge-lede {
    margin: 1 0 0 0;
}

#merge-lede {
    height: auto;
    color: $dai-muted;
}

/* The hairline over the list is this line's own bottom border, the way the
   header and the footer draw theirs — one less widget, and it follows the
   theme with nothing of ours redrawing it. */
#merge-from {
    height: auto;
    border-bottom: solid $dai-rule;
}

/* No max-height here: `MergeScreen._fit` owns it, because the cap has to be
   whatever the rest of the card is not using. A number in the sheet cannot
   know that, and the card clips rather than scrolls when it is wrong — which
   costs you the button and the way out, not a row. */
#merge-rows {
    height: auto;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-color: $dai-rule;
    scrollbar-color-hover: $dai-muted;
    scrollbar-color-active: $dai-solver;
}

/* Two lines of content and the gap under them, so the cursor reads as a band
   rather than a stripe — and so a row can never grow a third line. */
RepoRow {
    width: 1fr;
    height: 3;
    padding: 0 1;
}

/* The last row hands its gap to the rule below it. */
RepoRow:last-of-type {
    height: 2;
}

RepoRow.-cursor {
    background: $dai-highlight;
}

#merge-actions {
    border-top: solid $dai-rule;
}

/* One width for both, set rather than derived. `auto` sizes each control to its
   own label, and an `fr` split has to give its remainder to one of them —
   neither can be even at every terminal size, and a number can. 24 holds
   "Merge 12 selected"; anything longer is cut rather than wrapped, since a
   second line would push the row past the height it is drawn at.
   `min-width` has to be said: Button ships 16 and the Cell beside it ships
   none, which is what made them diverge on a narrow terminal. */
#merge-go,
#merge-toggle {
    width: 24;
    min-width: 24;
    max-width: 24;
    margin: 0 1 0 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* A keycap, not an action: there is no row a click on it could mean. Bordered
   and three rows, like the phase pill, so it sits level with the button. */
#merge-toggle {
    height: 3;
    padding: 0 1;
    border: round $dai-rule;
    content-align: center middle;
}

/* Cut, never wrapped — wrapping turns this into a three-line esc/Keep/the
   column that drags the whole row taller. */
#merge-keep {
    width: 1fr;
    min-width: 0;
    height: 3;
    content-align: right middle;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Too short for prose, or too narrow for the hint: fold away the parts that
   are not the question, rather than crop the parts that are. */
MergeScreen.-short #merge-lede,
MergeScreen.-short #merge-footnote {
    display: none;
}

MergeScreen.-narrow #merge-keep {
    display: none;
}

/* Still one width for both — narrower, not uneven. Two 24s plus the gap need
   49 columns, which is more than a 64-column terminal leaves inside the card,
   and the pill loses its right-hand border first. */
MergeScreen.-narrow #merge-go,
MergeScreen.-narrow #merge-toggle {
    width: 22;
    min-width: 22;
    max-width: 22;
}

#merge-footnote {
    height: auto;
    margin: 1 0 0 0;
    color: $dai-muted;
}
